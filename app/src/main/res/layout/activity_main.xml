<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/keyboard_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingTop="36dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <ImageView
            android:layout_width="144dp"
            android:layout_height="144dp"
            android:src="@drawable/brand_icon"
            android:contentDescription="@string/brand_logo_description"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/setup_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textColor="@color/key_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/setup_subtitle"
            android:textSize="16sp"
            android:textAlignment="center"
            android:textColor="@color/key_text"
            android:alpha="0.78" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/privacy_badge_background"
            android:paddingStart="14dp"
            android:paddingTop="9dp"
            android:paddingEnd="14dp"
            android:paddingBottom="9dp"
            android:text="@string/privacy_badge"
            android:textSize="13sp"
            android:textAlignment="center"
            android:textColor="@color/privacy_badge_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/setup_body"
            android:textSize="16sp"
            android:lineSpacingExtra="3dp"
            android:textAlignment="center"
            android:textColor="@color/key_text" />

        <Button
            android:id="@+id/enable_keyboard"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="30dp"
            android:text="@string/enable_keyboard"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/select_keyboard"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/select_keyboard"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/keyboard_preferences"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/key_text" />

        <Switch
            android:id="@+id/haptic_feedback"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:text="@string/haptic_feedback"
            android:textSize="16sp"
            android:textColor="@color/key_text" />

        <Button
            android:id="@+id/check_update"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:text="@string/check_update"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/update_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="14sp"
            android:textAlignment="center"
            android:textColor="@color/key_text"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
